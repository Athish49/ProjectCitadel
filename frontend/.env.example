# Frontend environment variables.
# Copy to .env.local for local development. Do not commit .env.local.
#
# Environment detection:
#   Local dev  — VERCEL is unset; BACKEND_URL defaults to localhost:8080
#   Vercel     — VERCEL="1" is injected automatically; set BACKEND_URL in the
#                Vercel project dashboard → Settings → Environment Variables.

# ─────────────────────────────────────────────────────────────────────────────
# Backend URL (server-side only — never exposed in the browser bundle).
# next.config.ts rewrites /api/backend/* → BACKEND_URL/* at the edge.
#
#   Local dev:  http://localhost:8080  (FastAPI default port)
#   Production: https://your-service.onrender.com
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8080

# ─────────────────────────────────────────────────────────────────────────────
# Vercel injects these automatically — do not set them manually.
# Listed here for reference only.
# ─────────────────────────────────────────────────────────────────────────────
# VERCEL=1
# VERCEL_ENV=production | preview | development
# NEXT_PUBLIC_VERCEL_ENV=production | preview | development
