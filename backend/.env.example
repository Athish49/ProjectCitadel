# Copy to .env and edit as needed. Do not commit .env.

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=secureclaim
POSTGRES_PORT=5432

# ChromaDB
CHROMADB_PORT=8000

# Tempo
TEMPO_HTTP_PORT=3200

# OpenTelemetry Collector
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

# Grafana (3001 to leave 3000 for Next.js / future frontend)
GRAFANA_PORT=3001

# FastAPI (host-side dev server; default 8080 to avoid collision with ChromaDB on 8000)
FASTAPI_PORT=8080
