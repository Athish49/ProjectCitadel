# Copy to .env and fill in real values. Do not commit .env.

# ─────────────────────────────────────────────────────────────────────────────
# Scenario A: LOCAL PostgreSQL via Docker Compose
# Uncomment the line below (and comment out Scenario B) to use a local DB.
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secureclaim

# ─────────────────────────────────────────────────────────────────────────────
# Scenario B: CLOUD — Neon PostgreSQL (or any managed Postgres)
# Comment out this line and uncomment Scenario A to switch to local.
# Replace <user>, <password>, <host>, <dbname> with your actual values.
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose local-stack variables (used only with Scenario A)
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=secureclaim
POSTGRES_PORT=5432

# Tempo
TEMPO_HTTP_PORT=3200

# OpenTelemetry Collector
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

# Grafana (3001 to leave 3000 for Next.js / future frontend)
GRAFANA_PORT=3001

# FastAPI (host-side dev server)
FASTAPI_PORT=8080

# Application DB role (non-superuser; RLS enforced). Created by migration 002.
# In production replace with a strong secret held in a secrets manager.
APP_DB_USER=secureclaim_app
APP_DB_PASSWORD=secureclaim_app

# Qdrant vector database (cloud)
QDRANT_URL=https://<cluster-id>.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=<your-qdrant-api-key>
QDRANT_POLICY_COLLECTION=ProjectCitadel-policy_docs
QDRANT_FRAUD_COLLECTION=ProjectCitadel-fraud_rules

# Adversarial agent (Sprint 4.3) — run with: docker compose --profile adversarial up
ADVERSARIAL_API_PORT=8081
ADVERSARIAL_LOG_LEVEL=INFO
ADVERSARIAL_LOOP_INTERVAL=300
MONTHLY_SPEND_CAP_USD=50.0
# ANTHROPIC_API_KEY must be set in the environment (not committed here)
# GITHUB_TOKEN must be set in the environment (not committed here)
# GITHUB_REPO=owner/repo  — set in environment to enable auto-issue creation on breach
